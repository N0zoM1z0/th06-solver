diff --git a/src/d3d8/d3d8_early_flush.cpp b/src/d3d8/d3d8_early_flush.cpp
new file mode 100644
index 0000000..9c390d6
--- /dev/null
+++ b/src/d3d8/d3d8_early_flush.cpp
@@ -0,0 +1,13 @@
+#include "../d3d9/d3d9_interfaces.h"
+#include "../util/com/com_pointer.h"
+
+namespace dxvk {
+  HRESULT D3D8FlushRenderingCommands(IUnknown* device) {
+    Com<ID3D9VkInteropDevice> interop;
+    HRESULT result = device->QueryInterface(__uuidof(ID3D9VkInteropDevice),
+      reinterpret_cast<void**>(&interop));
+    if (SUCCEEDED(result))
+      interop->FlushRenderingCommands();
+    return result;
+  }
+}
