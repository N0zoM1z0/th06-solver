execute_process(COMMAND "${CAMPAIGN}" --list --suite stages
  RESULT_VARIABLE result OUTPUT_VARIABLE stages)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "stage manifest failed")
endif()

# The Lunatic-only oracle is derived from the requested six stages/four shots,
# not from the scheduler's generated list. It must cover every selected seed.
execute_process(COMMAND "${CAMPAIGN}" --list --suite all --difficulty 3 --seeds 17,65535
  RESULT_VARIABLE result OUTPUT_VARIABLE selected)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Lunatic seed selection failed")
endif()
string(STRIP "${selected}" selected)
string(REPLACE "\n" ";" selected_cases "${selected}")
set(expected)
foreach(seed IN ITEMS 17 65535)
  foreach(stage RANGE 1 6)
    if(stage EQUAL 1)
      set(power 0)
    elseif(stage EQUAL 2)
      set(power 64)
    else()
      set(power 128)
    endif()
    foreach(shot RANGE 0 3)
      list(APPEND expected "s${stage}-d3-shot${shot}-seed${seed}-p${power}")
    endforeach()
  endforeach()
  foreach(shot RANGE 0 3)
    list(APPEND expected "story-d3-shot${shot}-seed${seed}")
  endforeach()
endforeach()
list(SORT selected_cases)
list(SORT expected)
if(NOT selected_cases STREQUAL expected)
  message(FATAL_ERROR "Lunatic manifest leaked difficulty, omitted seed or duplicated case")
endif()
foreach(bad IN ITEMS "17,17" "65536" "" "17," "17,,18")
  execute_process(COMMAND "${CAMPAIGN}" --list --difficulty 3 --seeds "${bad}"
    RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
  if(result EQUAL 0)
    message(FATAL_ERROR "invalid seed list accepted: ${bad}")
  endif()
endforeach()
execute_process(COMMAND "${CAMPAIGN}" --list --difficulty 3 --seed 17 --seeds 18
  RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
if(result EQUAL 0)
  message(FATAL_ERROR "ambiguous single/multiple seed selection accepted")
endif()
string(STRIP "${stages}" stages)
string(REPLACE "\n" ";" stage_cases "${stages}")
list(LENGTH stage_cases count)
list(REMOVE_DUPLICATES stage_cases)
list(LENGTH stage_cases unique)
if(NOT count EQUAL 96 OR NOT unique EQUAL 96 OR stages MATCHES "s6-d0" OR stages MATCHES "s[1-6]-d4")
  message(FATAL_ERROR "invalid legitimate stage coverage matrix")
endif()
execute_process(COMMAND "${CAMPAIGN}" --list --suite story
  RESULT_VARIABLE result OUTPUT_VARIABLE stories)
string(STRIP "${stories}" stories)
string(REPLACE "\n" ";" story_cases "${stories}")
list(LENGTH story_cases count)
list(REMOVE_DUPLICATES story_cases)
list(LENGTH story_cases unique)
if(NOT result EQUAL 0 OR NOT count EQUAL 16 OR NOT unique EQUAL 16 OR stories MATCHES "story-d4")
  message(FATAL_ERROR "invalid continuous story coverage matrix")
endif()
