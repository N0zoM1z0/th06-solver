file(MAKE_DIRECTORY "${WORK}")
foreach(mode plain profiled reuse_commit)
  set(extra)
  if(mode STREQUAL profiled)
    set(extra --profile)
  elseif(mode STREQUAL reuse_commit)
    set(extra --reuse 8)
  endif()
  execute_process(COMMAND "${PLAN}" --data "${DATA}" --stage 5 --difficulty 3
    --shot 1 --seed 7589 --power 128 --frames 64 --horizon 30 --commit 8
    --proposals 2 --reactive ${extra} --output "${WORK}/${mode}.actions"
    RESULT_VARIABLE code OUTPUT_VARIABLE report ERROR_VARIABLE diagnostic)
  if(NOT code EQUAL 2)
    message(FATAL_ERROR "Expected an incomplete profiling fixture: ${code} ${diagnostic}")
  endif()
  string(JSON native_profile GET "${report}" profile)
  if(NOT native_profile STREQUAL native-i386-v1)
    message(FATAL_ERROR "Profiling replaced the native profile identifier")
  endif()
  if(mode STREQUAL profiled)
    string(JSON timing_type TYPE "${report}" timings)
    if(NOT timing_type STREQUAL OBJECT)
      message(FATAL_ERROR "Missing phase timing object")
    endif()
  endif()
  execute_process(COMMAND "${CHECK}" --data "${DATA}" --tape "${WORK}/${mode}.actions"
    --require-complete RESULT_VARIABLE code OUTPUT_VARIABLE replay ERROR_VARIABLE diagnostic)
  string(JSON verified GET "${replay}" verified)
  if(NOT code EQUAL 2 OR NOT verified)
    message(FATAL_ERROR "Profiled prefix did not pass fresh replay: ${diagnostic}")
  endif()
endforeach()
file(SHA256 "${WORK}/plain.actions" plain_hash)
file(SHA256 "${WORK}/profiled.actions" profiled_hash)
if(NOT plain_hash STREQUAL profiled_hash)
  message(FATAL_ERROR "Profiling changed the native input/digest tape")
endif()
file(SHA256 "${WORK}/reuse_commit.actions" reuse_hash)
if(NOT plain_hash STREQUAL reuse_hash)
  message(FATAL_ERROR "Commit-sized reuse changed the legacy input/digest tape")
endif()
